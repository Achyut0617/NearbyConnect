# Copy this file to `.env` and fill in the values. NEVER commit the real .env.

# Database. Leave unset to use a local SQLite file (nearbyconnect.db).
# For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/nearbyconnect

# Web app CORS. "*" is fine for local dev; set your real web origin in production.
CORS_ORIGINS=*

# --- Phase 4 Stage B: area trend sources (optional; skipped if absent) ---
# Reddit "script" app (see docs/API_KEYS.md):
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# YouTube Data API v3 key (see docs/API_KEYS.md):
YOUTUBE_API_KEY=

# --- Phase 5 step 26: backup places provider (optional) ---
# Used only when every Overpass server fails. Free key: see docs/API_KEYS.md
GEOAPIFY_API_KEY=
